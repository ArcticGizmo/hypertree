<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Hypertree app head (assembly/exe name: hypertree). A tray-only Avalonia app that captures
    the global hotkeys, drives the NavigationModel, and paints the HUD chip. Windows-only for now;
    the Core/Platform split keeps a future cross-platform head possible. Composition root is
    PlatformServices (#if WINDOWS), mirroring perch.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hypertree.App</RootNamespace>
    <AssemblyName>hypertree</AssemblyName>
    <Product>Hypertree</Product>
    <Version>0.1.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe icon Explorer/taskbar shows. Generated from hypertree.svg by tools/IconGen. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- icon.png / icon.ico (generated from hypertree.svg) embedded so the tray + windows can load them
         at runtime via avares://hypertree/Assets/... -->
    <AvaloniaResource Include="Assets/**" />
    <!-- The changelog is embedded so the Settings "View changelog" page and the post-update "what's new"
         window can render it at runtime (read via the assembly manifest as "Hypertree.CHANGELOG.md"). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Hypertree.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- Velopack packs the tag-triggered release installer (see .github/workflows/release.yml) and
         runs the install/update lifecycle hooks via VelopackApp.Build().Run() at startup. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hypertree.Core\Hypertree.Core.csproj" />
    <ProjectReference Include="..\Hypertree.Platform.Windows\Hypertree.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
