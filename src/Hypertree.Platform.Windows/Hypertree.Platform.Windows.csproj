<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows implementations of Hypertree.Core's platform interfaces. This is the ONLY project that
    touches Win32 / the undocumented virtual-desktop COM surface. If a Windows update shifts the
    interface GUIDs/vtable (see ComInterop.cs), the change is contained here; the rest of Hypertree
    is unaffected. Proven working on build 26200 — see docs/design/m0-findings.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hypertree.Platform.Windows</RootNamespace>
    <AssemblyName>Hypertree.Platform.Windows</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon extraction for the app launcher: SHGetFileInfo hands back an HICON that Icon/Bitmap turn into
         PNG bytes (see ShellIconProvider). The App head already pins 10.0.9 to override the vulnerable
         transitive 4.7.0; match it here so the whole graph resolves to one safe version. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hypertree.Core\Hypertree.Core.csproj" />
  </ItemGroup>
</Project>
